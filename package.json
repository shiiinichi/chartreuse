{
  "name": "@chartreuse/ui",
  "version": "1.24.1",
  "private": true,
  "type": "module",
  "description": "A React 19 component library and design system.",
  "files": [
    "dist/lib",
    ".agents/skills/chartreuse/SKILL.md"
  ],
  "bin": {
    "chartreuse": "./dist/lib/chartreuse-cli.mjs"
  },
  "main": "./dist/lib/chartreuse.js",
  "module": "./dist/lib/chartreuse.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/chartreuse.js"
    },
    "./styles.css": "./dist/lib/chartreuse.css",
    "./tokens": {
      "types": "./dist/lib/tokens.d.ts",
      "import": "./dist/lib/tokens.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:site && npm run build:lib",
    "build:site": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && vite build --config vite.cli.config.ts",
    "query": "node dist/lib/chartreuse-cli.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "npm run build:lib && node --test test/*.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "1.61.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
